<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<AssemblyName>BatchReportAnalyzer</AssemblyName>
	<Description>Scans batch job reports and writes a PDF of detected issues</Description>
	<Copyright>Copyright 2026 Benjamin Trang</Copyright>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreedomFirst\FreedomFirst.Core.csproj" />
  </ItemGroup>

</Project>
